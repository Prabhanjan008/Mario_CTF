# ==============================================================================
# MARIO: THE CYBER HEIST — OJAS CTF ENVIRONMENT CONFIGURATION
# Chanakya University • OJAS Tech Fest 2026
# Copy this file to '.env' and populate with secret values for production.
# ==============================================================================

# Core Application Settings
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=generate-a-strong-random-key-for-production-min-32-chars

# Database Configuration
# Local Development: Leave blank or set to SQLite path
# Production (100+ Teams): Use PostgreSQL connection string:
# DATABASE_URL=postgresql+psycopg2://ojas_user:ojas_password@localhost:5432/ojas_ctf
DATABASE_URL=sqlite:///database/game.db

# Database Connection Pooling (PostgreSQL)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Server Binding
HOST=0.0.0.0
PORT=5000

# Organizer / Host Authentication Passkeys
# Comma-separated list of organizer authorization keys
ADMIN_KEYS=OJAS-HOST-ALPHA-7701,OJAS-HOST-BRAVO-9924,OJAS-HOST-SUPER-4418

# Rate Limiting & Anti-Brute-Force
JOIN_MAX_ATTEMPTS=10
JOIN_WINDOW_SECONDS=60
FLAG_MAX_ATTEMPTS=6
FLAG_WINDOW_SECONDS=10

# WSGI Server Concurrency Settings
WAITRESS_THREADS=24
WAITRESS_CHANNEL_TIMEOUT=60
GUNICORN_WORKERS=5
GUNICORN_THREADS=4
